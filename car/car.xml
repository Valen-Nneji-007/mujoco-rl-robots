<mujoco model="wheeled_robot">
  <option timestep="0.01"/>
  <default>
    <joint damping="0.01"/>
  </default>

  <worldbody>
    <light pos="0 0 3"/>
    <geom type="plane" size="2 2 0.1" rgba="0.9 0.9 0.9 1"/>

    <body name="chassis" pos="0 0 0.06">
      <freejoint name="root"/>
      <geom type="box" size="0.1 0.07 0.02" rgba="0.2 0.4 0.8 1" mass="1"/>
      <site name="front" pos="0.1 0 0" size="0.01" rgba="0 1 0 1"/>

      <body name="left_wheel" pos="0 0.09 -0.02">
        <joint name="left" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.04 0.01" euler="90 0 0" rgba="0.1 0.1 0.1 1"/>
      </body>

      <body name="right_wheel" pos="0 -0.09 -0.02">
        <joint name="right" type="hinge" axis="0 1 0"/>
        <geom type="cylinder" size="0.04 0.01" euler="90 0 0" rgba="0.1 0.1 0.1 1"/>
      </body>

      <geom name="caster" type="sphere" size="0.02" pos="0.08 0 -0.04" friction="0.01 0.005 0.0001" rgba="0.5 0.5 0.5 1"/>
    </body>

    <body name="target" pos="1 0.5 0.05" mocap="true">
      <geom type="sphere" size="0.05" rgba="1 0 0 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>

  <actuator>
    <motor joint="left" gear="0.1" ctrlrange="-1 1"/>
    <motor joint="right" gear="0.1" ctrlrange="-1 1"/>
  </actuator>
</mujoco>